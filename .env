# Mobil Uygulama Environment Variables

# API URL - Geliştirme ortamı için bilgisayarın IP adresi
EXPO_PUBLIC_API_URL=http://10.192.90.95:3000

# Socket.IO URL
EXPO_PUBLIC_SOCKET_URL=http://10.192.90.95:3000

# Uygulama ayarları
EXPO_PUBLIC_APP_NAME=Apartman Yönetim Sistemi
EXPO_PUBLIC_APP_VERSION=1.0.0

# Debug modu
EXPO_PUBLIC_DEBUG=true

# Cache süresi (dakika)
EXPO_PUBLIC_CACHE_DURATION=60 